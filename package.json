{
  "name": "restaurant-pulse",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "predev": "node scripts/pull-accounts-from-prod.mjs --soft",
    "dev": "node --env-file=.env.local node_modules/nuxt/bin/nuxt.mjs dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:init": "node scripts/init-db.mjs",
    "db:import-budget": "node scripts/import-budget-xlsx.mjs",
    "db:import-debt-schedule": "node scripts/import-debt-schedule.mjs",
    "db:import-capacity": "node scripts/import-capacity-projections.mjs",
