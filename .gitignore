# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# SQLite database (generated by `npm run db:init`, not checked in)
data/*.sqlite
data/*.sqlite3
*.sqlite
*.sqlite3
# ...except the sanitized QBO budget export template, which is safe (no
# real dollar figures) and needed by server/api/budget/export.get.ts —
# see scripts/import-budget-xlsx.mjs.
!data/qbo-budget-template.xlsx

# Real QBO exports (payroll figures, chart-of-accounts dumps) used as one-off
# script input — same reasoning as the real budget xlsx above: never check
# in the source file itself, only sanitized/derived artifacts.
data/*.csv

# Real Toast order-export CSVs (data/orders_cambridge_st/, data/orders_mass_ave/)
# — same "one-off source data, never checked in" reasoning as data/*.csv
# above, but these ship as directories of CSVs rather than loose files, so
# the flat data/*.csv pattern doesn't reach them.
data/orders_*/

# Personal Claude Code settings (permissions etc.), not shared config
.claude/settings.local.json

# Local-machine bookkeeping for scripts/pull-accounts-from-prod.mjs's predev
# throttle — not shared state, nothing to check in
data/.last-accounts-pull
